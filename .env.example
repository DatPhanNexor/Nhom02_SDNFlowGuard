# ==============================================================================
# SDNFlowGuard Environment Configuration Template (.env.example)
# Copy to .env and fill in credentials for your local lab environment.
# NEVER commit real passwords or API keys to version control.
# ==============================================================================

SDNFLOW_FLASK_HOST=127.0.0.1
SDNFLOW_FLASK_PORT=5000
SDNFLOW_FLASK_DEBUG=false
SDNFLOW_DB_PATH=database/sdnflowguard.db

# ONOS SDN Controller REST API
SDNFLOW_ONOS_URL=http://127.0.0.1:8181/onos/v1
SDNFLOW_ONOS_USER=
SDNFLOW_ONOS_PASSWORD=

# Elasticsearch & Logstash (ELK Stack)
SDNFLOW_ELK_URL=http://127.0.0.1:9200
SDNFLOW_ELK_USER=
SDNFLOW_ELK_PASSWORD=
SDNFLOW_LOGSTASH_HOST=127.0.0.1
SDNFLOW_LOGSTASH_PORT=18080

# Active Defense Safety Mode: DRY_RUN | AUTO_STAGE_ONLY | MANUAL_APPROVAL | ACTIVE_ENFORCEMENT
SDNFLOW_DEFENSE_MODE=DRY_RUN
SDNFLOW_ALLOWLIST_IPS=127.0.0.1,::1

# Optional API Key for mutating control endpoints (X-SDNFlow-API-Key header)
SDNFLOW_API_KEY=

# Optional OpenAI API Key for AI Security Assistant
OPENAI_API_KEY=

